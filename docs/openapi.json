    "/api/help/manual": {
      "get": {
        "tags": ["Help"], "operationId": "getManual", "summary": "使用手册（公开）",
        "security": [], "responses": { "200": { "description": "手册内容" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "用户 ID" },
      "DatasourceId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "数据源 ID（ds_ 前缀）" }
    },
    "responses": {
      "BadRequest": { "description": "参数错误（INVALID_INPUT）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "未登录或凭证失效（UNAUTHORIZED）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "角色不足或被强制改密拦截（FORBIDDEN / PASSWORD_CHANGE_REQUIRED）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "资源不存在或无权访问（NOT_FOUND，越权访问同样返回 404 防枚举）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "触发限流（RATE_LIMITED）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Internal": { "description": "服务端错误（INTERNAL_ERROR）", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string", "description": "用户可读错误信息" }, "code": { "type": "string", "description": "机器可读错误码（server/errorCodes.ts）" } }
      },
      "DatasourceInput": {
        "type": "object",
        "required": ["name", "type", "config"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["mysql", "postgres", "csv"] },
          "config": { "type": "object", "description": "连接配置（host/port/database/username/password 或 CSV 上传参数）" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
