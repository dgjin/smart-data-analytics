# ===== 系统元数据库（MySQL） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_analytics

# ===== AI 引擎（默认 Ollama 本地） =====
# 引擎选择：ollama / gemini / qwen；不设置时按密钥存在性自动选择
# AI_ENGINE=ollama
# 主推理模型（需先 ollama pull）
# 推荐 qwen3.8:27b-mlx（MLX 优化）；勿用 deepseek-r1 等推理模型——思考链分钟级会突破问数超时上限
LLM_MODEL=qwen3.8:27b-mlx
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=180000
# v0.9.3 多后端路由（可选）：同引擎多 Ollama 节点，最少并发路由 + 失败自动摘除 + 健康检查恢复；配置后优先于 OLLAMA_URL
# OLLAMA_URLS=http://host1:11434,http://host2:11434
# embedding 模型（圈表精排用，可选；需先 ollama pull nomic-embed-text）
EMBED_MODEL=nomic-embed-text
# v0.9.3 embedding 批量化（可选）：知识库导入/宽表列裁剪一次请求多段文本，单批最大文本数（默认 16，上限 64）
# EMBED_BATCH_SIZE=16

# P1-2 SQL 生成阶段快速模型路由（可选）：阶段一与复杂度评估用小而快模型；
# 两项均配置且合法时生效，用户自选模型始终优先。引擎限 ollama/gemini/qwen。
# 复杂度分档保护（v0.8.1）：仅简单单表问题走快速模型，复杂/多表强制主模型保口径。
# 本地推荐 qwen3:8b（非推理、中文强）；勿用 deepseek-r1 系列推理模型
# LLM_SQL_ENGINE=ollama
# LLM_SQL_MODEL=qwen3:8b

# 阶段二数据解读快速模型路由（可选）：解读属生成型任务，可用小模型大幅提速；
# 未配置时用主模型保证质量。本地推荐 qwen3:8b；云端示例 LLM_ANALYSIS_ENGINE=qwen + qwen3.7-flash；
# 切勿指向 deepseek-r1 系列推理模型（思考链分钟级必超时）
# LLM_ANALYSIS_ENGINE=ollama
# LLM_ANALYSIS_MODEL=qwen3:8b

# 小模型路由表数阈值（可选）：默认 1（仅单表查询走快速模型）；
# 设为 2 时双表非 multi-step 查询也走快速模型（提速 3~5 倍）。
# 注意：实测快速模型在多表 JOIN 时易漏 COUNT(DISTINCT) 造成重复计数，放宽后需关注准确率回归
# LLM_SQL_ROUTE_MAX_TABLES=2

# 问数结果缓存 TTL（分钟，可选）：默认 30；数据源结构/口径/范围变更时自动失效
# QUERY_CACHE_TTL_MINUTES=30

# 复杂度评估策略（可选）：默认启发式预门控（无去重/清洗类信号时跳过 LLM 评估直接判 simple）；
# ASSESS_ALWAYS_LLM=1 恢复每题必评的旧行为
# ASSESS_ALWAYS_LLM=1

# 备用引擎：Gemini API（配置后按 llmClient 策略切换）
# GEMINI_API_KEY=your_gemini_api_key

# 备用引擎：通义千问（百炼 OpenAI 兼容协议）
# 普通按量 Key（sk-xxx）用默认端点；Coding Plan Key（sk-sp-xxx）必须用
# 专属端点 https://coding.dashscope.aliyuncs.com/v1 且仅限编程工具使用
# QWEN_API_KEY=your_qwen_api_key
# QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# QWEN_EMBED_MODEL=text-embedding-v4
# QWEN_TIMEOUT_MS=180000

# ===== 安全 =====
# JWT 签名密钥：生产环境必填（缺失拒绝启动）；开发环境未配置时自动生成进程级临时密钥（重启后登录态失效）
# 请取消注释并替换为强随机串，例如：openssl rand -hex 32
# JWT_SECRET=replace-with-openssl-rand-hex-32
# JWT_EXPIRES_IN=12h
# 数据源凭据加密密钥（缺省回退 JWT_SECRET；注意：更换后已落库凭据需重新录入）
# DS_SECRET_KEY=replace-with-openssl-rand-hex-32
# 密码哈希 pepper（P2-8，可选）：与库表分离的服务级密钥，拖库后离线爆破仍需本配置配合；
# 注意：启用后再移除会导致用 pepper 哈希的密码全部无法登录（fail-closed）
# SCRYPT_PEPPER=replace-with-openssl-rand-hex-32

# 初始管理员账号（首次建库时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 服务 =====
PORT=3000
HOST=127.0.0.1

# ===== 限流与生成策略（可选） =====
# RATE_LIMIT_MAX=100
# USER_QUERY_RATE_MAX=20
# SELF_CORRECT_CANDIDATES=3

# ===== 数据源连接池分级（可选，v0.9.5） =====
# 按场景独立配额与执行超时：交互问数 / 分析链（报表、清洗链、评测）/ 导出类异步任务。
# 大导出占满自身配额时交互问数不排队；数据源配置变更后全场景池一并失效重建。
# DS_POOL_MAX=10                   # 交互池基准容量（缺省按 EXPECTED_CONCURRENT_USERS/4 推导，clamp [3,20]）
# DS_POOL_CHAIN=5                  # 分析链池（缺省 max(2, ceil(基准/2))）
# DS_POOL_EXPORT=2                 # 导出池（缺省 max(1, floor(基准/5))）
# QUERY_TIMEOUT_INTERACTIVE_MS=15000   # 交互执行超时（默认 15s）
# QUERY_TIMEOUT_CHAIN_MS=120000        # 分析链执行超时（默认 120s）
# QUERY_TIMEOUT_EXPORT_MS=60000        # 导出执行超时（默认 60s）

# ===== 状态外置（可选） =====
# 配置后计划/结果缓存/配额/并发槽/IP 限流外置 Redis，支持多实例水平扩展；
# 不配置（默认）使用进程内存，行为与单机部署完全一致
# REDIS_URL=redis://127.0.0.1:6379

# ===== 长任务队列（可选，v0.9.2） =====
# 报表生成/PDF 导出等分钟级任务经 async_tasks 表 + 内置 worker 异步执行
# TASK_WORKER_CONCURRENCY=2        # worker 并发上限（不占用户交互问数并发槽）
# TASK_QUEUE_USER_MAX=3            # 每用户在途任务上限（超限 429）
# TASK_HEARTBEAT_TIMEOUT_MS=90000  # 心跳超时判定孤儿（回队重跑或标失败）
# TASK_EXEC_TIMEOUT_MS=600000      # 单任务执行超时

# ===== AI Studio 遗留（仅部署到 AI Studio 时需要） =====
# APP_URL=https://your-app-url
