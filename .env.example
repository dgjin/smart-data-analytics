# ===== 系统元数据库（MySQL） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_analytics

# ===== AI 引擎（默认 Ollama 本地） =====
# 主推理模型（需先 ollama pull）
LLM_MODEL=deepseek-r1:32b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=180000
# embedding 模型（圈表精排用，可选；需先 ollama pull nomic-embed-text）
EMBED_MODEL=nomic-embed-text

# 备用引擎：Gemini API（配置后按 llmClient 策略切换）
# GEMINI_API_KEY=your_gemini_api_key

# ===== 安全 =====
# JWT 签名密钥（生产环境必填，缺失将拒绝启动）
JWT_SECRET=change-me-to-a-strong-secret
# JWT_EXPIRES_IN=12h
# 数据源凭据加密密钥（缺省回退 JWT_SECRET）
# DS_SECRET_KEY=change-me-too

# 初始管理员账号（首次建库时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 服务 =====
PORT=3000
HOST=127.0.0.1

# ===== 限流与生成策略（可选） =====
# RATE_LIMIT_MAX=100
# USER_QUERY_RATE_MAX=20
# SELF_CORRECT_CANDIDATES=3

# ===== AI Studio 遗留（仅部署到 AI Studio 时需要） =====
# APP_URL=https://your-app-url
