#!/bin/sh
# 企业级门禁（改进计划 Phase 1-1）：推送前本地强制质量检查，红灯代码不允许进入远程。
# 快速档：tsc 三档 + ESLint（error 级）+ OpenAPI 同步 + vitest 单测（不含 E2E：
# CI 的 e2e 作业运行 smoke 探针集；全量 E2E 本地执行 npm run test:e2e）。
# 紧急跳过仅限：git push --no-verify（CI 仍会拦截，务必慎用）。
set -e

echo "[pre-push] 质量门禁检查开始..."

echo "[pre-push] 1/7 tsc 主 tsconfig"
npm run lint --silent

echo "[pre-push] 2/7 tsc server strict"
npm run lint:server --silent

echo "[pre-push] 3/7 tsc 前端 strictNullChecks"
npm run lint:strict --silent

echo "[pre-push] 4/7 OpenAPI 同步校验"
npm run docs:check --silent

echo "[pre-push] 5/7 进程内状态巡检（P2-3）"
npm run state:check --silent

# P0-2：ESLint 仅拦 error 级（--quiet；warning 不阻断推送，避免历史存量告警刷屏）
echo "[pre-push] 6/7 ESLint（error 级）"
npx eslint . --quiet

echo "[pre-push] 7/7 vitest 全量单测"
npm test --silent

echo "[pre-push] 质量门禁全部通过，允许推送"
